# Pont IA Core3 (sidecar :8791) — /etc/lbg-core3-ia.env sur VM 245
CORE3_IA_ZONE=tatooine
CORE3_IA_BOT_NAME=Bot_IA
CORE3_IA_BOT_CHARACTER=Lia

# Routage LLM : voir /etc/lbg-ia-mmo.env (LBG_DIALOGUE_FAST_*, GROQ_API_KEY, Ollama 110…)
CORE3_IA_DIALOGUE_TARGET=auto
# CORE3_IA_AUTO_ORDER=fast,local,remote

# Incarnation Lia = orchestrateur LBG (docs/core3_ia_lia_orchestrator_incarnation.md)
# LBG_ORCHESTRATOR_URL=http://192.168.0.110:8010
# LBG_CORE3_LIA_ACTOR_ID=orchestrator:lia
# LBG_CORE3_LIA_HEAR_VIA=sidecar

# Connexion headless Lia (orchestrateur → POST /v1/lia/connect → sidecar → systemd)
# LBG_CORE3_LIA_AUTO_CONNECT=1
# LBG_CORE3_LIA_CONNECT_WAIT_S=120
# LBG_CORE3_LIA_CONNECT_MODE=systemd
# LBG_CORE3_LIA_BOT_SYSTEMD_UNIT=lbg-core3-ia-bot-client.service

# Boucle autonome Lia (orchestrateur VM 140 ou service lbg-core3-ia-lia-autonomy sur 245)
# LBG_CORE3_LIA_AUTONOMY_ENABLED=1
# LBG_CORE3_LIA_AUTONOMY_INTERVAL_S=45
# LBG_CORE3_LIA_AUTONOMY_MODE=invoke
# LBG_CORE3_IA_SIDECAR_URL=http://127.0.0.1:8791

# Boucle autonome générique joueurs IA (Nix, futurs bots)
# LBG_CORE3_PLAYER_AUTONOMY_ENABLED=1
# LBG_CORE3_PLAYER_AUTONOMY_INTERVAL_S=35
# LBG_CORE3_PLAYER_AUTONOMY_MODE=orchestrator
# LBG_CORE3_IA_PLAYER_ID=nix
