[Unit]
Description=LBG équipe virtuelle — jalon M9 Scrapaltai carte/minimap (dev_game L1)
After=network-online.target lbg-orchestrator.service
Wants=lbg-orchestrator.service

[Service]
Type=oneshot
User=lbg
Group=lbg
EnvironmentFile=-/etc/lbg-ia-mmo.env
Environment=PYTHONPATH=/opt/LBG_IA_MMO/agents/src
Environment=LBG_TEAM_M9_MAP_JOB_ENABLED=1
Environment=LBG_ORCHESTRATOR_URL=http://127.0.0.1:8010
Environment=LBG_TEAM_M9_MAP_JOB_STATE=/var/lib/lbg/team_m9_map/state.json
Environment=LBG_TEAM_M9_MAP_JOB_ACTOR_ID=system:team_m9_map
Environment=LBG_PRIME_CLIENT_ROOT=/opt/new_mmo/prime-client
Environment=LBG_NEW_MMO_ROOT=/opt/new_mmo
ExecStart=/opt/LBG_IA_MMO/.venv/bin/python -m lbg_agents.spawn_team_m9_map_job

[Install]
WantedBy=multi-user.target
