[Unit]
Description=LBG Core3 Prime — watchdog login (sonde auth + StreamIndex)
Documentation=file:///opt/LBG_IA_MMO/docs/core3_prime_runbook.md
After=network-online.target lbg-core3-prime.service lbg-core3-ia-sidecar.service
Wants=lbg-core3-prime.service

[Service]
Type=oneshot
User=lbg
Group=lbg
EnvironmentFile=-/etc/lbg-ia-mmo.env
Environment=LBG_CORE3_PRIME_WATCHDOG_ENABLED=1
ExecStart=/bin/bash /opt/LBG_IA_MMO/infra/scripts/watch_core3_prime_login_health.sh --json
