[Unit]
Description=LBG équipe virtuelle — pistes client Godot M3/M5/ZB-0 (dev_game L1)
After=network-online.target lbg-orchestrator.service
Wants=lbg-orchestrator.service

[Service]
Type=oneshot
User=lbg
Group=lbg
EnvironmentFile=-/etc/lbg-ia-mmo.env
Environment=PYTHONPATH=/opt/LBG_IA_MMO/agents/src
Environment=LBG_TEAM_GODOT_CLIENT_TRACKS_JOB_ENABLED=1
Environment=LBG_ORCHESTRATOR_URL=http://127.0.0.1:8010
Environment=LBG_TEAM_GODOT_CLIENT_TRACKS_JOB_STATE=/var/lib/lbg/team_godot_client_tracks/state.json
Environment=LBG_TEAM_GODOT_CLIENT_TRACKS_JOB_ACTOR_ID=system:team_godot_client_tracks
Environment=LBG_TEAM_GODOT_SOE_M3=1
Environment=LBG_TEAM_GODOT_SOE_M5=0
Environment=LBG_NEW_MMO_ROOT=/opt/new_mmo
Environment=LBG_CLIENT_PRIME_LBG_DIR=/opt/new_mmo/client-prime-lbg
ExecStart=/opt/LBG_IA_MMO/.venv/bin/python -m lbg_agents.spawn_team_godot_client_tracks_job

[Install]
WantedBy=multi-user.target
