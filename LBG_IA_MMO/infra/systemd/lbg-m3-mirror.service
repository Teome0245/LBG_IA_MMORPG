[Unit]
Description=LBG M3 mirror — zone_feed Prime → Godot UDP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/opt/LBG_IA_MMO/infra/config/m3_mirror.env
WorkingDirectory=/opt/LBG_IA_MMO
ExecStart=/opt/LBG_IA_MMO/tools/zone_observer/run_m3_mirror_daemon.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
