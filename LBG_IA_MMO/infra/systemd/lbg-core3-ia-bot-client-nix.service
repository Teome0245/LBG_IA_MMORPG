[Unit]
Description=LBG joueur bot headless — compte Bot_IA_2, perso Nix Bot (Serveur Prime)
Documentation=file:///opt/LBG_IA_MMO/docs/core3_ia_phase_f_multi_players.md
After=network-online.target lbg-core3-prime.service lbg-core3-ia-sidecar.service
Wants=network-online.target lbg-core3-prime.service

[Service]
Type=simple
User=lbg
Group=lbg
WorkingDirectory=/opt/lbg-new-mmo-clean/MMOCoreORB/bin
Environment=CORE3_IA_SIDECAR_URL=http://127.0.0.1:8791
Environment=CORE3_IA_BOT_CHARACTER=Nix
Environment=CORE3_CLIENT_ENV_FILE=/opt/lbg-new-mmo-clean/MMOCoreORB/bin/.env-core3client-nix
Environment=CORE3_CLIENT_OPTIONS_JSON=/opt/lbg-new-mmo-clean/MMOCoreORB/bin/ia_bridge/nix_bot_session.json
ExecStart=/bin/bash -lc 'while true; do /opt/LBG_IA_MMO/infra/scripts/run_core3_ia_bot_client_vm.sh || true; sleep 60; done'
Restart=always
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
