[Unit]
Description=LBG équipe virtuelle — sonde joueurs IA Prime 246 (tâche player_ia L1)
After=network-online.target lbg-orchestrator.service
Wants=lbg-orchestrator.service

[Service]
Type=oneshot
User=lbg
Group=lbg
EnvironmentFile=-/etc/lbg-ia-mmo.env
Environment=PYTHONPATH=/opt/LBG_IA_MMO/agents/src
Environment=LBG_TEAM_PLAYER_IA_JOB_ENABLED=1
Environment=LBG_ORCHESTRATOR_URL=http://127.0.0.1:8010
Environment=LBG_TEAM_PLAYER_IA_JOB_STATE=/var/lib/lbg/team_player_ia/state.json
Environment=LBG_TEAM_PLAYER_IA_JOB_ACTOR_ID=system:team_player_ia
Environment=LBG_CORE3_SIDECAR_URL=http://192.168.0.246:8791
ExecStart=/opt/LBG_IA_MMO/.venv/bin/python -m lbg_agents.spawn_team_player_ia_job

[Install]
WantedBy=multi-user.target
