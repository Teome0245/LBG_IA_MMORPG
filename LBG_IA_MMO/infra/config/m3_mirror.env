# VM 140    : /opt/LBG_IA_MMO/infra/config/m3_mirror.env

PRIME_HOST=192.168.0.246
PRIME_USER=lbg
GODOT_PORT=12345

# IP du PC où tourne Godot (obligatoire si le service n'est pas sur la même machine)
# WSL local : laisser vide (auto via resolv.conf → Windows)
# VM 140    : IP LAN du PC Windows (ex. 192.168.0.50)
GODOT_HOST=

PRIME_CLIENT=/home/sdesh/projects/new_mmo/prime-client
TRACK_PLAYERS=Lia,Nix,Mira,Gally,Teome

# false = inclure les PNJ ia_bridge dans le flux UDP + JSON
MIRROR_PLAYERS_ONLY=false
