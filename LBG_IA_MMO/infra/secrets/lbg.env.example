# Copier vers lbg.env : cp infra/secrets/lbg.env.example infra/secrets/lbg.env
# Maintenance : même structure et ordre que infra/secrets/lbg.env (local) — à mettre à jour
# dans le même changement ; jamais de secrets réels ici. Voir docs/plan_de_route.md priorité 0.
# =============================================================================

# =============================================================================
# LBG_IA_MMO — Services principaux
# =============================================================================
# Topologie LAN (plan / docs/fusion_env_lan.md) :
#   140 = backend + orchestrateur + agents | 110 = Ollama (Pilot)
#   245 = MariaDB + mmo_server (8050) + mmmorpg WS (7733) + PreCU Core3 (4445x)
#   246 = Prime Core3 (4455x) + sidecar IA :8791 + bots Lia/Nix
# Même fichier sur les 3 VM : IP LAN réelles pour le core (pas 127.0.0.1 — sinon 245/110 visent la mauvaise machine).

LBG_ORCHESTRATOR_URL="http://192.168.0.140:8010"
LBG_AGENT_DIALOGUE_URL="http://192.168.0.140:8020"
LBG_AGENT_QUESTS_URL="http://192.168.0.140:8030"
LBG_AGENT_COMBAT_URL="http://192.168.0.140:8040"
# Chef de projet (intent project_pm) — systemd lbg-agent-pm port 8055 sur core
LBG_AGENT_PM_URL="http://192.168.0.140:8055"
# Desktop (hybride) — Mode produit « local_assistant » (ADR 0004) : worker HTTP sur le poste
# (Windows : windows_agent/Agent_IA → C:\Agent_IA, voir docs/desktop_hybride.md ; Linux : linux_agent/Agent_IA).
# Si absent : orchestrateur/core peut router desktop_control mais l’agent dispatch sans worker distant
# retombe sur exécution locale des tests uniquement (voir agents/README.md § Desktop).
# LBG_AGENT_DESKTOP_URL="http://192.168.0.50:8060"
# open_app : learn auto (allowlist auto-apprise sur le worker à la 1re exécution réelle).
# Défaut activé (=1) ; mettre 0 pour n'apprendre que si l'app est explicitement allowlistée.
# Les apps Office (word/excel…) et hors PATH (swgemu) gardent learn=true même si désactivé ici.
# LBG_DESKTOP_OPEN_APP_LEARN=1
# Alias gérés côté orchestrateur : notepad→notepadpp, swg/swgemu.exe→swgemu, msword/winword→word, mozilla→firefox.
# Chemin .exe fourni dans l'objectif entre parenthèses (ex. « lance swgemu (J:\swgemu\…\SWGEmu.exe) ») → rempli dans desktop_action.command.
# Recherche web (action search_web_open) — désactivée par défaut ; HTTPS DuckDuckGo ou Google uniquement.
# Linux : équivalent `LBG_LINUX_WEB_SEARCH` / `LBG_LINUX_SEARCH_ENGINE` (voir linux_agent + docs/desktop_hybride.md).
LBG_DESKTOP_WEB_SEARCH="1"
LBG_DESKTOP_SEARCH_ENGINE="duckduckgo"
# Messagerie IMAP (action mail_imap_preview) — désactivée par défaut ; lecture seule INBOX ; secrets uniquement dans lbg.env local
# LBG_DESKTOP_MAIL_ENABLED="1"
# LBG_DESKTOP_MAIL_IMAP_HOST="imap.example.com"
# LBG_DESKTOP_MAIL_IMAP_PORT="993"
# LBG_DESKTOP_MAIL_IMAP_USER="user@example.com"
# LBG_DESKTOP_MAIL_IMAP_PASSWORD="change-moi"
# Linux : LBG_LINUX_MAIL_ENABLED, LBG_LINUX_MAIL_IMAP_* (voir linux_agent)
LBG_CORS_ORIGINS="http://192.168.0.110,http://192.168.0.110:8080"

# MMO server — choisis l’un des deux (local ou LAN)
# LBG_MMO_SERVER_URL="http://127.0.0.1:8050"
LBG_MMO_SERVER_URL="http://192.168.0.245:8050"
# Client web (Vite) : fetch `GET /v1/world/collision-grid` — lister les origines autorisées (séparateur virgule).
# Ex. dev local : LBG_MMO_CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
# Ou raccourci **uniquement en dev** : si `LBG_MMO_CORS_ORIGINS` est vide, `LBG_MMO_CORS_DEV=1` ajoute 5173/4173 localhost.
# LBG_MMO_CORS_DEV=1
# LAN (front sur 110) : compléter avec l’URL réelle du client, ex. :
# LBG_MMO_CORS_ORIGINS="http://192.168.0.110:5173,http://192.168.0.110:8080"
# Écriture interne sur mmo_server (optionnel) : si défini, protège
# `POST /internal/v1/npc/{npc_id}/reputation` via `X-LBG-Service-Token`.
# Recommandation : utiliser la même valeur que `LBG_PILOT_INTERNAL_TOKEN` (simplifie les smokes + double-write).
# LBG_MMO_INTERNAL_TOKEN="change-moi"
# Persistance / seed (surtout sur la VM 245 où tourne mmo_server — sinon défauts dans le code)
# LBG_MMO_SEED_PATH=
# LBG_MMO_STATE_PATH="/var/lib/lbg/mmo/world_state.json"
# LBG_MMO_SAVE_INTERVAL_S=30
# LBG_MMO_DISABLE_PERSIST=0

# Serveur WebSocket jeu (mmmorpg_server) — systemd lbg-mmmorpg-ws sur 245 ; clients → ws://192.168.0.245:7733
# À activer sur la VM 245 (ou tout fichier poussé vers /etc/lbg-ia-mmo.env pour ce service)
MMMORPG_HOST=0.0.0.0
MMMORPG_PORT=7733
MMMORPG_INTERNAL_HTTP_HOST="0.0.0.0"
MMMORPG_INTERNAL_HTTP_PORT="8773"
MMMORPG_INTERNAL_HTTP_TOKEN="change-moi"
MMMORPG_INTERNAL_HTTP_RL_RPS="5"
MMMORPG_INTERNAL_HTTP_RL_BURST="10"
# Métriques HTTP interne (:8773) — l’unité lbg-mmmorpg-ws fixe MMMORPG_INTERNAL_HTTP_METRICS=0 par défaut.
# MMMORPG_INTERNAL_HTTP_METRICS=1
MMMORPG_STATE_PATH="/var/lib/lbg/mmmorpg/state.json"
MMMORPG_DISABLE_PERSIST=0
LBG_MMMORPG_INTERNAL_HTTP_URL="http://192.168.0.245:8773"
LBG_MMMORPG_INTERNAL_HTTP_TOKEN="change-moi"
# MMMORPG_TICK_RATE_HZ=20
# MMMORPG_MAX_WS_INBOUND_BYTES=65536
# MMMORPG_MOVE_MIN_INTERVAL_S=0.02
#
# Pont jeu → IA (optionnel) : permet au serveur WS d'appeler le backend monorepo (hello → /v1/pilot/route).
MMMORPG_IA_BACKEND_URL="http://192.168.0.140:8000"
MMMORPG_IA_TIMEOUT_S="45"
MMMORPG_IA_BACKEND_PATH="/v1/pilot/internal/route"
MMMORPG_IA_BACKEND_TOKEN="change-moi"
MMMORPG_IA_PLACEHOLDER_ENABLED="1"
MMMORPG_IA_PLACEHOLDER_REPLY="…un instant. ({npc_name} vous regarde, comme s’il réfléchissait.)"

# Durcissement backend (VM 140) — endpoint interne /v1/pilot/internal/route
LBG_PILOT_INTERNAL_TOKEN="change-moi"
LBG_PILOT_INTERNAL_RL_RPS="2"
LBG_PILOT_INTERNAL_RL_BURST="4"

# Observabilité (opt-in) — lu par systemd (lbg-backend, lbg-orchestrator) via /etc/lbg-ia-mmo.env
# Les unités fixent LBG_METRICS_ENABLED=0 par défaut ; ce fichier peut le passer à 1 sur la VM core.
# LBG_METRICS_ENABLED=1
# LBG_METRICS_TOKEN="change-moi"

# =============================================================================
# Companion bot (microservice chat autonome) — systemd lbg-companion-bot (port 8065)
# =============================================================================
# DB SQLite (sur la VM qui héberge le service) :
# LBG_COMPANION_DB_PATH="/var/lib/lbg/companion/companion.sqlite3"
# Origines UI autorisées (Phase 2 / dev Vite, ex. 110:5174) :
# LBG_COMPANION_CORS_ORIGINS="http://192.168.0.110:5174,http://192.168.0.110:8080"
# Base URL pour l'UI (dev) :
# VITE_COMPANION_BASE_URL="http://192.168.0.140:8065"
# Debug par défaut (payload JSON renvoyé si debug=true ; à laisser à 0 en prod) :
# LBG_COMPANION_DEBUG_DEFAULT="0"
#
# LLM OpenAI-compatible (Ollama LAN sur 110) :
# LBG_COMPANION_LLM_BASE_URL="http://192.168.0.110:11434/v1"
# LBG_COMPANION_LLM_API_KEY=""
# LBG_COMPANION_LLM_MODEL="phi4-mini:latest"
# LBG_COMPANION_LLM_TIMEOUT="60"
# LBG_COMPANION_LLM_TEMPERATURE="0.4"
# LBG_COMPANION_LLM_MAX_TOKENS="512"
# Pour forcer le mode stub (aucun appel LLM) :
# LBG_COMPANION_LLM_DISABLED="1"
# Historique max (messages) injecté au prompt :
# LBG_COMPANION_MAX_HISTORY="18"
#
# Autonomie / tick (Phase 1.5) :
# LBG_COMPANION_AUTONOMOUS_TICK_ENABLED="1"
# LBG_COMPANION_AUTONOMOUS_MIN_NUDGE_INTERVAL_S="60"
# LBG_COMPANION_AUTONOMOUS_WINDOW_S="3600"
# LBG_COMPANION_AUTONOMOUS_MAX_NUDGES_PER_WINDOW="5"

# Brain orchestrateur (autonomie) + bridge optionnel Brain -> Lyra
# LBG_BRAIN_ENABLED="0"
# LBG_BRAIN_INTERVAL_S="30"
# LBG_BRAIN_DEVOPS_AUTORESTART="0"
# LBG_BRAIN_DEVOPS_APPROVAL="change-moi"
# LBG_BRAIN_STATE_PATH="/var/lib/lbg/brain/state.json"
# LBG_BRAIN_MAX_ACTIONS_PER_TICK="3"
# LBG_BRAIN_RESTART_COOLDOWN_S="600"
# Bridge actif (backend): applique une influence faible du Brain sur context.lyra avant routage
# LBG_BRAIN_LYRA_BRIDGE_ENABLED="1"
# LBG_BRAIN_LYRA_WORLD_SCALE="0.03"
# LBG_BRAIN_LYRA_ASSISTANT_SCALE="5"
# Régulateur Lyra safe (objectif: éviter dérive des jauges, 1 action max + cooldown)
# LBG_LYRA_REGULATOR_ENABLED="1"
# LBG_LYRA_REGULATOR_COOLDOWN_S="60"
# LBG_LYRA_REGULATOR_WORLD_WARNING="0.55"
# LBG_LYRA_REGULATOR_WORLD_CRITICAL="0.75"

# =============================================================================
# Réconciliation IA → jeu (commit dialogue) — contrat backend (phase C)
# =============================================================================
# (optionnel) Whitelist config-driven (si non défini : défauts dans backend/services/mmmorpg_commit.py)
# LBG_MMMORPG_COMMIT_ALLOWED_FLAGS="quest_accepted,quest_id,quest_step,mood,rp_tone,reputation_delta"
# (optionnel) Limites best-effort (le serveur jeu revalide aussi)
# LBG_MMMORPG_COMMIT_MAX_FLAGS="16"
# LBG_MMMORPG_COMMIT_MAX_KEY_LEN="64"
# LBG_MMMORPG_COMMIT_MAX_STR_LEN="256"

# Timeouts orchestrateur / agents
LBG_AGENT_DIALOGUE_TIMEOUT="45"
LBG_ORCHESTRATOR_TIMEOUT="45"
# Appels LLM (Ollama / OpenAI-compatible) : 30s est souvent trop court (chargement modèle, premier jeton).
LBG_DIALOGUE_LLM_TIMEOUT="180"
# (optionnel) Plancher pour les tours `_desktop_plan` (Pilot #/desktop « Proposer via IA ») si le timeout global reste bas.
# LBG_DIALOGUE_LLM_TIMEOUT_DESKTOP_MIN="240"
# Backend Pilot → agent dialogue POST /invoke — doit rester ≥ timeout LLM agent + marge (~30s).
LBG_PILOT_AGENT_DIALOGUE_INVOKE_TIMEOUT="300"
# (optionnel) Pilot Assistant Core · proxy même-origine depuis le backend MMO vers le FastAPI **projet LBG_IA**
# (`GET /metrics`, `GET /monitor/agents`). Doc LAN : **140** héberge orch MMO + pile LBG_IA ; **110** = Ollama + front (pas ce backend).
# Compose officiel LBG_IA : backend **:3000** (`orchestrateur/docker-compose.yml`). Uvicorn hors conteneur souvent **:8000** (`orchestrateur/DEV_RUN.md`).
# Avec le même `lbg.env` sur 140/245/110, préférer l’IP LAN du core pour éviter toute confusion avec le loopback d’une autre VM :
# LBG_PILOT_LBGIA_BACKEND_URL="http://192.168.0.140:3000"
# LBG_PILOT_LBGIA_HTTP_TIMEOUT="3"

LBG_AGENT_COMBAT_TIMEOUT="30"

# Forge OpenGame (prototype_game / agent.opengame) — dry-run par défaut
# LBG_OPENGAME_SANDBOX_DIR="/var/lib/lbg/opengame"
# LBG_OPENGAME_DRY_RUN="1"
# LBG_OPENGAME_EXECUTION_ENABLED="0"
# LBG_OPENGAME_BIN="opengame"
# LBG_OPENGAME_TIMEOUT_S="900"
# LBG_OPENGAME_MAX_OUTPUT_CHARS="12000"
# LBG_OPENGAME_APPROVAL_TOKEN="change-moi"
# LBG_OPENGAME_AUDIT_LOG_PATH="/var/log/lbg/opengame_audit.jsonl"
# LBG_OPENGAME_AUDIT_STDOUT="1"


# =============================================================================
# Catalogue monde (races / bestiaire) — optionnel
# =============================================================================
# Par défaut : JSON sous LBG_IA_MMO/content/world/ (races.json, creatures.json).
# Sur une VM, tu peux pointer vers un répertoire déployé hors git :
# LBG_WORLD_CONTENT_DIR="/var/lib/lbg/world-content"

# =============================================================================
# Dialogue LLM (Agent HTTP :8020)
# =============================================================================
# Défauts dans dialogue_llm.py si rien n’est défini :
#   BASE_URL=http://127.0.0.1:11434/v1
#   MODEL=llama3.2:latest
# Pour forcer le mode stub sans Ollama : LBG_DIALOGUE_LLM_DISABLED=1
#
# Failover (optionnel) : si LBG_DIALOGUE_FAILOVER=1, après timeout / erreur réseau / HTTP ≥500,
# réessaie les paliers listés dans LBG_DIALOGUE_FAILOVER_ORDER (sinon = LBG_DIALOGUE_AUTO_ORDER).
# Exemple : gros modèle (local) puis petit modèle sur le même Ollama (fast).
# LBG_DIALOGUE_FAILOVER=1
# LBG_DIALOGUE_FAILOVER_ORDER=local,fast
# LBG_DIALOGUE_TARGET_DEFAULT=local
# LBG_DIALOGUE_AUTO_ORDER=local,fast,remote
# LBG_DIALOGUE_FAST_ENABLED=1
# LBG_DIALOGUE_FAST_BASE_URL="http://192.168.0.110:11434/v1"
# LBG_DIALOGUE_FAST_MODEL="phi4-mini:latest"
# LBG_DIALOGUE_FAST_API_KEY=""

# --- Groq (optionnel) ---
# LBG_DIALOGUE_LLM_BASE_URL="https://api.groq.com/openai/v1"
# LBG_DIALOGUE_LLM_MODEL="llama-3.1-8b-instant"
GROQ_MODEL_FAST="llama-3.1-8b-instant"
GROQ_MODEL_BALANCED="llama-3.1-8b-instant"
GROQ_MODEL_SMART="llama-3.1-8b-instant"

# --- Ollama (LAN) ---
LBG_DIALOGUE_LLM_BASE_URL="http://192.168.0.110:11434/v1"
LBG_DIALOGUE_LLM_MODEL="phi4-mini:latest"
# Infra Ollama lente, réponses vides ou time out : autre tag (`ollama list`, ex. llama3.2, qwen2.5) ou monter les timeouts
# (le backend Pilot doit rester ≥ timeout LLM agent, marge ~60 s) :
# LBG_DIALOGUE_LLM_MODEL="llama3.2:latest"
# LBG_DIALOGUE_LLM_TIMEOUT="300"
# LBG_DIALOGUE_LLM_TIMEOUT_DESKTOP_MIN="420"
# LBG_PILOT_AGENT_DIALOGUE_INVOKE_TIMEOUT="480"
# LLM distant rapide (ex. Groq) : activer LBG_DIALOGUE_FAST_ENABLED + clés ; puis dans le contexte JSON desktop Pilot ajouter "dialogue_target":"fast".
# Répliques PNJ : 512 par défaut côté code agent. Mettre une valeur très basse (ex. 32) tronque quasi systématiquement la sortie modèle.
LBG_DIALOGUE_LLM_MAX_TOKENS="512"
LBG_DIALOGUE_LLM_TEMPERATURE="0.2"
LBG_DIALOGUE_STRICT_SHORT="1"
LBG_DIALOGUE_MAX_SENTENCES="3"
LBG_DIALOGUE_MAX_WORDS="52"
# Optionnel : taille max d’une ligne dans l’API HTTP « lines » (défaut 2000 caractères).
# LBG_DIALOGUE_HTTP_MAX_LINE_CHARS="2000"
LBG_DIALOGUE_LLM_MAX_HISTORY="8"
LBG_DIALOGUE_CACHE_TTL_S="120"
LBG_DIALOGUE_CACHE_MAX_ITEMS="512"
LBG_DIALOGUE_CACHE_CONTEXT_KEYS="world_npc_id,quest_state,encounter_state,world_flags"
LBG_DIALOGUE_ADMIN_TOKEN="change-moi"
# Propositions structurées Pilot « Desktop → Proposer via IA » : activer sur l’hôte qui exécute l’agent dialogue (8020).
# Sans cela, le bandeau Pilot signale « Mode DESKTOP_JSON désactivé » et meta.desktop_action_proposal reste absent.
LBG_DIALOGUE_DESKTOP_PLAN="1"
# Si le LLM oublie DESKTOP_JSON mais le joueur dit « ouvre vlc » : inférer open_app (désactiver : LBG_DIALOGUE_DESKTOP_INFER_OPEN_APP=0).
# LBG_DIALOGUE_DESKTOP_INFER_OPEN_APP="1"
# Profil de style par défaut (si pas de `context.dialogue_profile` ni de `tone` résolvable dans npc_registry).
# LBG_DIALOGUE_PROFILE_DEFAULT="professionnel"
# Multi-LLM : context.dialogue_target parmi local | remote | fast | auto (auto = ordre LBG_DIALOGUE_AUTO_ORDER + budget optionnel).
# L’orchestrateur injecte `context.dialogue_target` par défaut (`fast` ci‑dessous) sur les dialogues PNJ.
# Pour tout passer en auto côté monde : `LBG_ORCHESTRATOR_DIALOGUE_TARGET_DEFAULT="auto"`.
LBG_ORCHESTRATOR_DIALOGUE_TARGET_DEFAULT="fast"
# Agent dialogue seul (sans injection orchestrateur) : défaut si pas de dialogue_target dans le body
# LBG_DIALOGUE_TARGET_DEFAULT="local"
# LBG_DIALOGUE_AUTO_ORDER="local,fast,remote"
# Budget soft (USD) : borne les paliers payants uniquement en mode auto
# LBG_DIALOGUE_BUDGET_MAX_USD="5"
# Coûts estimés fast (USD / 1K tokens) pour le budget + traces
# LBG_DIALOGUE_FAST_COST_IN_PER_1K="0"
# LBG_DIALOGUE_FAST_COST_OUT_PER_1K="0"
# Profil injecté par l’orchestrateur quand le body ne contient pas `dialogue_profile`. Si défini ici, il
# prime sur le champ `tone` du registre PNJ (alias → profil, voir `REGISTRY_TONE_ALIASES` dans `dialogue_llm`).
# Laisser commenté ou vide pour que le `tone` data-driven du registre s’applique aux PNJ monde.
# LBG_ORCHESTRATOR_DIALOGUE_PROFILE_DEFAULT="professionnel"
#
# --- Orchestrateur : classification d’intention en langage courant (API OpenAI-compatible, optionnel) ---
# Active un LLM **avant** les agents uniquement pour choisir l’intent (dialogue, quête, DevOps, PM, …).
# Les actions structurées (`desktop_action`, `devops_action`, …) restent prioritaires. Pas d’intent desktop/world/opengame via LLM.
# LBG_ORCHESTRATOR_INTENT_LLM="1"
# LBG_ORCHESTRATOR_INTENT_LLM_BASE_URL="http://127.0.0.1:11434/v1"
# LBG_ORCHESTRATOR_INTENT_LLM_MODEL="llama3.2"
# LBG_ORCHESTRATOR_INTENT_LLM_API_KEY=""
# LBG_ORCHESTRATOR_INTENT_LLM_TIMEOUT_S="25"
# Si le classifieur mots-clés a déjà trouvé une intent ≠ unknown, le LLM ne remplace que si confidence >= seuil (défaut 0.92).
# LBG_ORCHESTRATOR_INTENT_LLM_OVERRIDE_CONF="0.92"
# Côté client : `context._intent_classify` = "llm" | "deterministic" surcharge ce flag (Pilot accueil → liste « Routage intention »).

# Moteur de jobs autonome ("type Cowork", sous garde-fous) — objectif NL -> plan -> exécution de fond auto-corrigée.
# Voir docs/assistant_core_plan.md (Jalon 7). Endpoints : POST/GET /v1/jobs, /v1/jobs/{id}(/approve|/cancel|/advance).
# Runner de fond (thread daemon). OFF par défaut (comme le Brain) : à activer quand on veut l'exécution autonome.
# LBG_JOBS_RUNNER_ENABLED="0"
# LBG_JOBS_RUNNER_INTERVAL_S="2"
# Auto-correction : nombre max de tentatives par étape avant échec.
# LBG_JOBS_STEP_MAX_ATTEMPTS="2"
# Si "1", un échec d'étape ne stoppe pas le job (les étapes suivantes sont tentées). Défaut "0" (stop au 1er échec).
# LBG_JOBS_CONTINUE_ON_STEP_FAILURE="0"
# Auto-correction niveau objectif : nb de RE-PLANIFICATIONS auto après épuisement des retries d'une étape
# (re-planifie l'objectif avec le journal d'erreurs au lieu d'abandonner). Borné ; 0 pour désactiver. Défaut "1".
# Un replan n'a lieu que s'il produit un plan DIFFÉRENT (utile surtout avec le planner LLM).
# LBG_JOBS_MAX_REPLANS="1"
# Mémoire d'expériences (apprentissage léger : succès/échecs réinjectés au planner LLM).
# Défaut activée ; chemin par défaut à côté de LBG_JOBS_STATE_PATH (experiences.jsonl). Vide => mémoire volatile.
# LBG_JOBS_MEMORY_ENABLED="1"
# LBG_JOBS_MEMORY_PATH="/var/lib/lbg/jobs/experiences.jsonl"
# Persistance best-effort des jobs (vide => désactive la persistance, état en mémoire seulement).
# LBG_JOBS_STATE_PATH="/var/lib/lbg/jobs/state.json"
# Persistance Redis optionnelle (prioritaire sur le fichier ; fallback fichier/mémoire si indispo).
# Nécessite le paquet `redis` (extra orchestrateur: `pip install -e ./orchestrator[redis]`).
# LBG_JOBS_REDIS_URL="redis://127.0.0.1:6379/0"
# Disposition des clés Redis :
#   - "index" (défaut, recommandé) : une clé par job `{prefix}:job:{id}` + un set d'index `{prefix}:index`.
#     Scalable (multivers) : chaque mutation n'écrit que le job concerné, pas tout le snapshot.
#   - "snapshot" : ancienne disposition, un unique blob JSON dans LBG_JOBS_REDIS_KEY.
# LBG_JOBS_REDIS_LAYOUT="index"
# Préfixe des clés en layout "index" :
# LBG_JOBS_REDIS_PREFIX="lbg:jobs"
# Clé du snapshot unique (layout "snapshot" uniquement) :
# LBG_JOBS_REDIS_KEY="lbg:jobs:state"
# Token d'approbation pour l'autonomie semi-auto : si défini, un job doit fournir EXACTEMENT ce token
# (approval_token / POST /approve) pour exécuter réellement une action à effet de bord ; sinon le job
# reste en dry-run et met les étapes à risque en `waiting_approval`. Si vide, tout token non vide est accepté.
# LBG_JOBS_APPROVAL_TOKEN="change-moi"
# Élargissement du périmètre **capability par capability** : liste des capabilities autorisées à s'exécuter
# RÉELLEMENT (effet de bord) dans un job pré-autorisé. Vide => tout reste en dry-run même avec un token.
# Ex : "desktop_control,devops_probe". Une capability hors liste reste en dry-run / `waiting_approval`.
# LBG_JOBS_REAL_CAPABILITIES=""
# Planner LLM optionnel (opt-in) : objectif NL -> plan JSON multi-étapes (revalidé contre une allowlist).
# Repli déterministe systématique si désactivé/erreur. Côté client : `context._planner` = "llm" | "deterministic".
# LBG_JOBS_PLANNER_LLM="0"
# LBG_JOBS_PLANNER_LLM_BASE_URL="http://192.168.0.110:11434/v1"
# LBG_JOBS_PLANNER_LLM_MODEL="gemma4:e2b"
# LBG_JOBS_PLANNER_LLM_API_KEY=""
# LBG_JOBS_PLANNER_LLM_TIMEOUT_S="30"
# Élévation agentique : si "1" (ou context.prefer_agentic=true), un message Chat actionnable sur /route
# crée un JOB de fond (plan + exécution auto-corrigée) au lieu d'un dispatch one-shot. OFF par défaut.
# N'élève que des intents actionnables connus ET seulement si le runner de jobs est activé.
# LBG_CHAT_AGENTIC="0"
# Couche proactive (hybrid_proactive_agent greffé sur /v1/route + daemon) :
# LBG_PROACTIVE_ENABLED="0"
# LBG_PROACTIVE_INTERVAL_S="300"
# LBG_PROACTIVE_AUTO_JOBS="1"
# LBG_PROACTIVE_ROUTE_HINTS="1"
# LBG_PROACTIVE_ACTOR_ID="system:proactive"
# LBG_PROACTIVE_MIN_JOB_INTERVAL_S="900"
# LBG_PROACTIVE_STATE_PATH="/var/lib/lbg/proactive/state.json"
# Jobs proactifs Lia (alternance infra/Lia si sidecar MMO joignable ; ignoré si LBG_CORE3_LIA_AUTONOMY_ENABLED=1) :
# LBG_PROACTIVE_LIA_JOBS="0"
# LBG_PROACTIVE_LIA_OBJECTIVE="Tour proactif Lia en MMO — incarnation orchestrateur, une action en jeu (observe et agis)."

# Watchdog login Core3 Prime (VM 245 — timer lbg-core3-prime-watchdog.timer, 5 min) :
# LBG_CORE3_PRIME_WATCHDOG_ENABLED="1"
# LBG_CORE3_PRIME_WATCHDOG_COOLDOWN_S="2700"
# LBG_CORE3_PRIME_WATCHDOG_STREAM_ERRORS="4"
# LBG_CORE3_PRIME_WATCHDOG_LOGIN_TIMEOUT_S="50"
# LBG_CORE3_PRIME_WATCHDOG_MIN_UPTIME_S="600"
# LBG_CORE3_PRIME_WATCHDOG_GRACE_AFTER_RESTART_S="900"

# Cooldown social Lia (anti-spam interact greet en jeu) :
# LBG_CORE3_LIA_PROACTIVE_COOLDOWN_S="180"
# LBG_CORE3_LIA_GREET_COOLDOWN_S="600"

# =============================================================================
# SSH multi‑VM (action DevOps `ssh_run`) — agir sur les VM LAN (140/110/245) sous garde-fous.
# DÉSACTIVÉ par défaut. Commandes **allowlistées** uniquement ; dry-run + approbation comme les
# autres actions DevOps sensibles. Cibler via action.server_id (linux-140/110/245, core/front/mmo).
# =============================================================================
# LBG_MCP_SSH_ENABLED="1"
# LBG_VM_MEMORY_PROBE_ENABLED="1"
# LBG_VM_MEMORY_PROBE_HOSTS="prime=246,precu=245,front=110,core=140"
# LBG_VM_MEMORY_WARN_PCT="15"
# LBG_VM_MEMORY_CRIT_PCT="8"
# LBG_VM_MEMORY_WATCHDOG_ENABLED="1"
# LBG_VM_MEMORY_WATCHDOG_RESTART="0"
# Remédiation RAM (Track C) — plan via infra_watchdog ; restart Prime jamais sans approbation.
# LBG_REMEDIATION_PRIME_ENABLED="0"
# LBG_REMEDIATION_HOST_UNITS="prime=lbg-core3-prime.service,precu=lbg-core3-precu.service,front=nginx.service,core=lbg-orchestrator.service"
# LBG_INFRA_WATCHDOG_EXCLUDE_PRIME="0"
# LBG_INFRA_WATCHDOG_STATE="/var/lib/lbg/infra_watchdog/state.json"
# Utilisateur SSH et clé privée (BatchMode, pas de mot de passe interactif).
# LBG_SSH_USER="lbg"
# LBG_SSH_IDENTITY="/home/lbg/.ssh/id_ed25519"
# LBG_SSH_TIMEOUT_S="45"
# Allowlist de commandes (regex séparées par des virgules). Vide => défaut read-only sûr
# (curl -…, systemctl is-active/status …, journalctl -u …, uptime, df -…, free, test -…).
# LBG_SSH_CMD_ALLOWLIST="^curl\s+-,^systemctl\s+is-active\s+,^journalctl\s+-u\s+"
# Hôtes LAN par rôle (sinon IPs LAN par défaut 140/110/245) ; et hôte « local » de l'orchestrateur.
# LBG_LAN_HOST_CORE="192.168.0.140"
# LBG_LAN_HOST_FRONT="192.168.0.110"
# LBG_LAN_HOST_CORE3_PRIME="192.168.0.246"
# LBG_LAN_HOST_PRECU="192.168.0.245"
# LBG_LAN_HOST_MMO_SERVER="192.168.0.245"
# LBG_LAN_HOST_MMO="192.168.0.246"
# LBG_ORCHESTRATOR_HOST="192.168.0.140"

# Inventaire réseau LAN (jobs `network_inventory`) — scan TCP read-only du sous-réseau.
# Exécuté depuis le core (140) : découvre tous les hôtes 192.168.0.x avec ports ouverts.
# LBG_NETWORK_SCAN_ENABLED="1"
# LBG_NETWORK_SCAN_CIDR="192.168.0.0/24"
# LBG_NETWORK_SCAN_TIMEOUT_S="0.45"
# LBG_NETWORK_SCAN_WORKERS="64"
# Résolution DNS inverse (hostname) sur les IP découvertes :
# LBG_NETWORK_REVERSE_DNS="1"
# LBG_NETWORK_REVERSE_DNS_TIMEOUT_S="1.0"
# Étiquettes explicites (ajouter synology / esxi / proxmox avec leurs IP réelles) :
# IP du routeur/box (Freebox souvent .254, pas .1) :
# LBG_NETWORK_ROUTER_HOST="192.168.0.254"
# LBG_NETWORK_KNOWN_DEVICES='[{"host":"192.168.0.254","label":"freebox-routeur","role":"router"},{"host":"192.168.0.10","label":"pc-windows","role":"desktop"},{"host":"192.168.0.51","label":"synology-nas","role":"nas"},{"host":"192.168.0.100","label":"serveur-ad","role":"ad"},{"host":"192.168.0.110","label":"front-pilot-ollama","role":"front"},{"host":"192.168.0.140","label":"core-orchestrateur","role":"core"},{"host":"192.168.0.200","label":"proxmox-1","role":"hypervisor"},{"host":"192.168.0.201","label":"proxmox-2","role":"hypervisor"},{"host":"192.168.0.217","label":"vmware-esxi","role":"hypervisor"},{"host":"192.168.0.245","label":"mmo-db-precu","role":"precu","server_id":"precu"},{"host":"192.168.0.246","label":"core3-prime-vm","role":"mmo","server_id":"prime"}]'

# Proxmox VE (World Director / SysOps — API read-only, MCP tools/mcp_proxmox_server)
# Token : Datacenter → Permissions → API Tokens (rôle PVEAuditor + Sys.Audit pour VMs/heure)
# LBG_PROXMOX_HOST="192.168.0.201"
# Plusieurs hyperviseurs (futur second PVE) — virgules :
# LBG_PROXMOX_HOSTS="192.168.0.201,192.168.0.200"
# LBG_PROXMOX_PORT="8006"
# LBG_PROXMOX_TOKEN="root@pam!lbg-readonly=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# LBG_PROXMOX_VERIFY_SSL="0"
# SSH ops fuseau (root requis sur l'hôte PVE — ne redémarre pas les VM) :
# LBG_PROXMOX_SSH_USER="root"
# LBG_PROXMOX_SSH_HOSTS="192.168.0.201,192.168.0.200"
# Sonde : bash infra/scripts/probe_proxmox_lan.sh
# Stockage thin (io-error VM 246) : bash infra/scripts/check_proxmox_storage_lan.sh
# LBG_PROXMOX_SSH_HOST="192.168.0.201"
# LBG_PROXMOX_SSH_IDENTITY="/home/lbg/.ssh/id_ed25519"   # clé autorisée sur root@PVE (sonde stockage VM 140)
# LBG_PROXMOX_THIN_WARN_PCT="85"
# LBG_PROXMOX_THIN_CRIT_PCT="95"
# Job Pilot automatique (VM core 140, timer lbg-storage-watchdog-job) :
# LBG_STORAGE_WATCHDOG_JOBS_ENABLED="1"
# LBG_STORAGE_WATCHDOG_OBJECTIVE="Surveillance stockage Proxmox local-lvm et Prime 246 — sonde thin pool, remédiation disque si alerte"
# LBG_STORAGE_WATCHDOG_ACTOR_ID="system:storage_watchdog"
# LBG_STORAGE_WATCHDOG_STATE="/var/lib/lbg/storage_watchdog/state.json"
# LBG_STORAGE_WATCHDOG_COOLDOWN_WARN_S="1800"
# LBG_STORAGE_WATCHDOG_COOLDOWN_CRITICAL_S="900"
# LBG_STORAGE_AUTO_HYGIENE="1"
# Jobs visibles : http://192.168.0.110:8080/#/jobs — exécution :
# LBG_JOBS_RUNNER_ENABLED="1"
# LBG_JOBS_APPROVAL_TOKEN=""   # requis pour apply SSH hygiene Prime hors dry-run
# Fuseau hôte : bash infra/scripts/set_proxmox_timezone_europe_paris.sh
# Mapping optionnel label=vmid Proxmox (sinon résolution par nom VM) :
# LBG_PROXMOX_VM_LABELS="core=101,front=102,precu=103,prime=104"

# Sidecar Core3 IA (MCP tools/mcp_lbg_core3_server) — défaut VM Prime 246
# LBG_CORE3_SIDECAR_URL="http://192.168.0.246:8791"

# SSH MCP + watchdog infra (VM core 140 — Phase A SysOps, Prime exclu pendant rebuild)
# LBG_MCP_SSH_ENABLED="1"
# LBG_SSH_USER="lbg"
# LBG_SSH_IDENTITY="/home/lbg/.ssh/id_ed25519"
# LBG_INFRA_WATCHDOG_ENABLED="1"
# LBG_INFRA_WATCHDOG_EXCLUDE_PRIME="1"
# LBG_INFRA_WATCHDOG_STATE="/var/lib/lbg/infra_watchdog/state.json"
# LBG_VM_MEMORY_PROBE_EXCLUDE="prime,mmo"

